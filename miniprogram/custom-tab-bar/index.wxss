.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 110rpx;
  background: #7C191E;
  display: flex;
  padding-bottom: env(safe-area-inset-bottom);
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.15);
  z-index: 999;
}

.tab-bar-border {
  background-color: rgba(255, 255, 255, 0.2);
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 1rpx;
}

.tab-bar-item {
  flex: 1;
  text-align: center;
  display: flex;
  justify-content: center;
  align-items: center;
  flex-direction: column;
  position: relative;
}

.icon-wrapper {
  width: 44rpx;
  height: 44rpx;
  margin-bottom: 6rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  transition: all 0.3s ease;
}

.icon-wrapper.active {
  transform: translateY(-4rpx);
}

/* 纯 CSS 绘制的精致图标 */
.icon-box {
  position: relative;
  transition: all 0.3s;
}

/* 选中状态下图标颜色变化 (配合 text-active) */
.active .icon-box {
  transform: scale(1.1);
}

/* --- 图标 0: 树洞 (Tree) --- */
.icon-0 {
  width: 0;
  height: 0;
  border-left: 14rpx solid transparent;
  border-right: 14rpx solid transparent;
  border-bottom: 24rpx solid #e0e0e0; /* 树冠 */
  margin-bottom: 6rpx;
  position: relative;
}

/* 树干 */
.icon-0::after {
  content: '';
  position: absolute;
  top: 24rpx; /* 接在树冠下面 */
  left: -4rpx; /* (14 - 4*2)/2 - 14 */
  width: 8rpx;
  height: 10rpx;
  background: #e0e0e0;
}

/* 选中态：树变成金色 */
.active .icon-0 {
  border-bottom-color: #FFD700;
}
.active .icon-0::after {
  background: #FFD700;
}


/* --- 图标 1: 广场 (Discussion/Square) --- */
/* 两个对话气泡 */
.icon-1 {
  width: 32rpx;
  height: 24rpx;
  background: #e0e0e0;
  border-radius: 6rpx;
  position: relative;
  box-shadow: 4rpx 4rpx 0 rgba(255,255,255,0.2); /* 简单的重叠效果 */
}

/* 气泡尾巴 */
.icon-1::before {
  content: '';
  position: absolute;
  bottom: -6rpx;
  left: 6rpx;
  width: 0;
  height: 0;
  border-left: 8rpx solid transparent;
  border-top: 8rpx solid #e0e0e0;
}

/* 气泡内的横线 */
.icon-1::after {
  content: '';
  position: absolute;
  top: 8rpx;
  left: 6rpx;
  width: 20rpx;
  height: 8rpx;
  border-top: 2rpx solid #7C191E;
  border-bottom: 2rpx solid #7C191E;
  opacity: 0.3;
}

/* 选中态 */
.active .icon-1 {
  background: #FFD700;
  box-shadow: 4rpx 4rpx 0 rgba(255,255,255,0.3);
}
.active .icon-1::before {
  border-top-color: #FFD700;
}


/* --- 图标 2: 我的 (User) --- */
.icon-2 {
  width: 22rpx;
  height: 22rpx;
  background: #e0e0e0;
  border-radius: 50%; /* 头 */
  position: relative;
  top: -6rpx;
}

/* 身体 */
.icon-2::after {
  content: '';
  position: absolute;
  top: 26rpx;
  left: 50%;
  transform: translateX(-50%); /* 绝对居中 */
  width: 36rpx;
  height: 16rpx;
  background: #e0e0e0;
  border-radius: 16rpx 16rpx 0 0; /* 圆润的肩膀 */
}

/* 选中态 */
.active .icon-2, .active .icon-2::after {
  background: #FFD700;
}

.tab-text {
  font-size: 20rpx;
  color: #e0e0e0;
  transition: all 0.3s ease;
}

.text-active {
  color: #FFD700;
  font-weight: bold;
}

.active-line {
  position: absolute;
  bottom: 10rpx;
  width: 30rpx;
  height: 4rpx;
  background: #FFD700;
  border-radius: 2rpx;
  animation: slideIn 0.3s ease;
}

@keyframes slideIn {
  from { width: 0; opacity: 0; }
  to { width: 30rpx; opacity: 1; }
}