.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 110rpx;
  background: #7C191E;
  display: flex;
  padding-bottom: env(safe-area-inset-bottom);
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.15);
  z-index: 999;
}

.tab-bar-border {
  background-color: rgba(255, 255, 255, 0.2);
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 1rpx;
}

.tab-bar-item {
  flex: 1;
  text-align: center;
  display: flex;
  justify-content: center;
  align-items: center;
  flex-direction: column;
  position: relative;
}

.icon-wrapper {
  width: 44rpx;
  height: 44rpx;
  margin-bottom: 6rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  transition: all 0.3s ease;
}

.icon-wrapper.active {
  transform: translateY(-4rpx);
}

/* 纯 CSS 绘制的简单图标 */
.icon-box {
  border: 3rpx solid #e0e0e0;
  box-sizing: border-box;
}

/* 树洞图标 (像个树冠) */
.icon-0 {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50% 50% 0 0;
  position: relative;
}
.icon-0::after {
  content: '';
  position: absolute;
  bottom: -6rpx;
  left: 8rpx;
  width: 4rpx;
  height: 8rpx;
  background: #e0e0e0;
}

/* 发布图标 (加号) */
.icon-1 {
  width: 26rpx;
  height: 26rpx;
  position: relative;
  border: none;
}
.icon-1::before, .icon-1::after {
  content: '';
  position: absolute;
  background: #e0e0e0;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}
.icon-1::before { width: 100%; height: 3rpx; }
.icon-1::after { width: 3rpx; height: 100%; }

/* 我的图标 (人头) */
.icon-2 {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  position: relative;
}
.icon-2::after {
  content: '';
  position: absolute;
  bottom: -12rpx;
  left: -4rpx;
  width: 28rpx;
  height: 12rpx;
  border: 3rpx solid #e0e0e0;
  border-radius: 12rpx 12rpx 0 0;
  border-bottom: none;
}

.active .icon-box, 
.active .icon-box::before, 
.active .icon-box::after {
  border-color: #FFD700 !important;
  background-color: #FFD700 !important;
}
.active.icon-1::before, .active.icon-1::after {
  background-color: #FFD700 !important;
}

.tab-text {
  font-size: 20rpx;
  color: #e0e0e0;
  transition: all 0.3s ease;
}

.text-active {
  color: #FFD700;
  font-weight: bold;
}

.active-line {
  position: absolute;
  bottom: 10rpx;
  width: 30rpx;
  height: 4rpx;
  background: #FFD700;
  border-radius: 2rpx;
  animation: slideIn 0.3s ease;
}

@keyframes slideIn {
  from { width: 0; opacity: 0; }
  to { width: 30rpx; opacity: 1; }
}