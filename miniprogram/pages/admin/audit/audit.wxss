/* pages/admin/audit/audit.wxss */
page {
  background: linear-gradient(to bottom, #7C191E 0%, #a52a2a 15%, #F0F2F5 30%);
  min-height: 100vh;
}

.container {
  padding: 0 24rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

/* 返回按钮 */
.nav-back {
  position: fixed;
  left: 20rpx;
  width: 32px;
  height: 32px;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.2);
  border-radius: 50%;
  backdrop-filter: blur(4px);
}

.back-arrow {
  width: 10px;
  height: 10px;
  border-left: 2px solid #ffffff;
  border-bottom: 2px solid #ffffff;
  transform: rotate(45deg);
  margin-left: 4px;
}

.page-header {
  padding: 20rpx 10rpx 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}

.page-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
}

.page-subtitle {
  font-size: 26rpx;
  color: rgba(255,255,255,0.8);
}

.loading-state {
  text-align: center;
  padding-top: 200rpx;
  color: #999;
  font-size: 30rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
  gap: 30rpx;
  color: #666;
  font-size: 30rpx;
}

.card-list {
  height: calc(100vh - 200rpx);
}

.audit-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.tag-row {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.tag {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

.tag-q {
  background: #E8F3FF;
  color: #1890FF;
}

.tag-w {
  background: #FFF7E6;
  color: #FA8C16;
}

.tag-cat {
  background: #F5F5F5;
  color: #666;
}

.tag-anon {
  background: #333;
  color: #fff;
}

.time-text {
  font-size: 24rpx;
  color: #999;
}

.card-body {
  margin-bottom: 24rpx;
  padding: 20rpx;
  background: #FAFAFA;
  border-radius: 12rpx;
  min-height: 120rpx;
}

.content-text {
  font-size: 30rpx;
  color: #333;
  line-height: 1.7;
  white-space: pre-wrap;
  word-break: break-all;
}

.card-footer {
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #eee;
  margin-bottom: 24rpx;
}

.openid-text {
  font-size: 22rpx;
  color: #bbb;
  font-family: monospace;
}

.card-actions {
  display: flex;
  gap: 24rpx;
}

.action-btn {
  flex: 1;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border: none;
}

.btn-reject {
  background: #FFF1F0;
  color: #FF4D4F;
  border: 2rpx solid #FFCCC7;
}

.btn-pass {
  background: #F6FFED;
  color: #52C41A;
  border: 2rpx solid #B7EB8F;
}

.btn-hover {
  opacity: 0.7;
  transform: scale(0.98);
}

