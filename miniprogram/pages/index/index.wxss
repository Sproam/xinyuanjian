/* pages/index/index.wxss */
.container {
  height: 100vh;
  background: linear-gradient(to bottom, #7C191E, #a52a2a, #f6f6f6); /* 中大红渐变背景 */
  display: flex;
  flex-direction: column;
  overflow: hidden;
  padding-bottom: 110rpx; /* 为自定义 TabBar 留出空间 */
  box-sizing: border-box;
}

.header {
  padding: 40rpx 0;
  text-align: center;
  z-index: 10;
}

/* 跑马灯样式 */
.marquee-box {
  width: 100%;
  height: 70rpx;
  background: rgba(255, 255, 255, 0.15);
  overflow: hidden;
  white-space: nowrap;
  display: flex;
  align-items: center;
  backdrop-filter: blur(5px);
}

.marquee-content {
  display: inline-block;
  animation: marquee 20s linear infinite;
}

.marquee-item {
  display: inline-block;
  padding: 0 40rpx;
  font-size: 26rpx;
  color: #ffffff;
  font-weight: 500;
}

@keyframes marquee {
  0% { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}

/* 氛围层：落花 */
.ambient-layer {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 1;
}

.petal {
  position: absolute;
  top: -20rpx;
  width: 15rpx;
  height: 15rpx;
  background: #ffc0cb; /* 粉色落花 */
  border-radius: 15rpx 0 15rpx 15rpx;
  opacity: 0.6;
  animation: fall linear infinite;
}

@keyframes fall {
  0% {
    transform: translateY(0) rotate(0deg);
    opacity: 0.6;
  }
  100% {
    transform: translateY(100vh) rotate(720deg);
    opacity: 0;
  }
}


.title {
  font-size: 48rpx;
  font-weight: bold;
  color: #ffffff; /* 白色文字在深色背景上更清晰 */
  letter-spacing: 4rpx;
  text-shadow: 0 4rpx 10rpx rgba(0,0,0,0.2);
}

.subtitle-box {
  margin-top: 10rpx;
}

.subtitle {
  font-size: 26rpx;
  color: rgba(255,255,255,0.8);
  font-style: italic;
}

/* 刷新按钮 */
.refresh-btn {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  width: 64rpx;
  height: 64rpx;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 10rpx rgba(0,0,0,0.1);
  z-index: 20;
  padding: 0;
}

.refresh-icon {
  font-size: 40rpx; /* 稍微调大一点 */
  color: #7C191E;
  font-weight: bold;
  line-height: 1; /* 消除默认行高影响 */
  margin-bottom: 4rpx; /* 微调视觉中心 */
}

/* 树容器 */
.tree-wrapper {
  flex: 1;
  position: relative;
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: flex-end;
}

.tree-image {
  width: 95%;
  height: 90%;
  margin-bottom: 20rpx;
  filter: drop-shadow(0 10rpx 20rpx rgba(0,0,0,0.2));
}

.empty-tip {
  position: absolute;
  top: 40%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: rgba(255,255,255,0.7);
  padding: 20rpx 40rpx;
  border-radius: 40rpx;
  font-size: 24rpx;
  color: #8b4513;
  pointer-events: none;
}

/* 祈福签样式：与参考图一致 */
.wish-tag-item {
  position: absolute;
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: sway 3s ease-in-out infinite alternate;
  transform-origin: top center;
  will-change: transform;
  backface-visibility: hidden;
  transform: translateZ(0);
}

.tag-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  padding-top: 28rpx;
}

/* 挂绳：从树枝到挂环，与背景区分 */
.tag-rope {
  width: 2rpx;
  height: 32rpx;
  background: linear-gradient(180deg, #e8dcb8 0%, #c9a227 40%, #a89068 100%);
  border-radius: 1rpx;
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  box-shadow: 0 0 0 1rpx rgba(180, 150, 80, 0.5), 0 2rpx 6rpx rgba(0,0,0,0.15);
}

/* 顶部挂环（小圆孔），金边更明显 */
.tag-loop {
  width: 12rpx;
  height: 8rpx;
  border: 2rpx solid rgba(200, 170, 90, 0.95);
  border-top: none;
  border-radius: 0 0 50% 50%;
  margin-top: -2rpx;
  box-sizing: border-box;
  background: transparent;
  box-shadow: 0 1rpx 4rpx rgba(0,0,0,0.12);
}

/* 云朵状顶头：暖白/米色+金边+阴影（提问签用）；红色签单独见下 */
.tag-cloud {
  width: 56rpx;
  height: 22rpx;
  background: linear-gradient(180deg, #fffbf5 0%, #fdf4e6 50%, #f5ebd8 100%);
  border: 2rpx solid rgba(200, 170, 90, 0.85);
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.18), 0 0 0 1rpx rgba(255,255,255,0.6) inset;
  position: relative;
  margin-top: -1rpx;
  clip-path: polygon(0% 100%, 8% 55%, 28% 18%, 50% 0%, 72% 18%, 92% 55%, 100% 100%);
}

/* 红色祈愿签顶部：浅朱红云头 + 金红挂绳挂环 */
.tag-content.wish .tag-rope {
  background: linear-gradient(180deg, #e8c4b8 0%, #c9a227 35%, #8b3a3a 100%);
  box-shadow: 0 0 0 1rpx rgba(180, 100, 80, 0.4), 0 2rpx 8rpx rgba(80,20,20,0.2);
}

.tag-content.wish .tag-loop {
  border-color: rgba(200, 150, 90, 0.95);
  box-shadow: 0 1rpx 4rpx rgba(80,20,20,0.18), 0 0 0 1rpx rgba(255,220,200,0.3) inset;
}

.tag-content.wish .tag-cloud {
  background: linear-gradient(180deg, #fff5f2 0%, #fde8e4 40%, #f5d0c8 70%, #e8b8b0 100%);
  border: 2rpx solid rgba(180, 120, 100, 0.9);
  box-shadow: 0 2rpx 10rpx rgba(100,30,30,0.25), 0 0 0 1rpx rgba(255,240,235,0.8) inset;
}

.tag-content.wish .tag-cloud-dot {
  background: radial-gradient(circle at 30% 30%, #f5e0c0, #c9a227 40%, #8b6914 70%, #6b3020 100%);
  box-shadow: 0 0 0 1rpx rgba(180, 120, 80, 0.5), inset 0 1rpx 0 rgba(255,255,255,0.35);
}

.tag-cloud-dot {
  position: absolute;
  left: 50%;
  top: 78%;
  transform: translate(-50%, -50%);
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 30% 30%, #f0e6c8, #c9a227 45%, #8b6914 100%);
  box-shadow: 0 0 0 1rpx rgba(180, 150, 80, 0.6), inset 0 1rpx 0 rgba(255,255,255,0.4);
}

/* 签身：纯直条矩形，左右金边，无下缘波浪 */
.tag-body {
  position: relative;
  width: 56rpx;
  min-height: 176rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 8rpx 12rpx;
  margin-top: -2rpx;
  box-sizing: border-box;
  border-left: 3rpx solid rgba(200, 170, 90, 0.95);
  border-right: 3rpx solid rgba(200, 170, 90, 0.95);
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
}

.tag-content.wish .tag-body {
  background: linear-gradient(180deg, #8b2942 0%, #722f37 30%, #5c2028 100%);
}

.tag-content.question .tag-body {
  background: linear-gradient(180deg, #f8f4eb 0%, #ebe3d0 50%, #e0d6c0 100%);
}

/* 云朵下方的横带：与签身同色，底边金纹 */
.tag-band {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  height: 14rpx;
  border-bottom: 2rpx solid rgba(200, 170, 90, 0.9);
  pointer-events: none;
}

.tag-content.wish .tag-band {
  background: linear-gradient(180deg, #9a3548 0%, #722f37 100%);
}

.tag-content.question .tag-band {
  background: linear-gradient(180deg, #e8e0d0 0%, #e0d6c0 100%);
}

/* 云朵状底脚：下缘中间低、两侧高（与顶头对称） */
.tag-footer {
  width: 56rpx;
  height: 20rpx;
  margin-top: -2rpx;
  border-top: 2rpx solid rgba(200, 170, 90, 0.9);
  box-sizing: border-box;
  /* 下缘中间下垂、两侧上翘 */
  clip-path: polygon(0% 0%, 8% 45%, 28% 82%, 50% 100%, 72% 82%, 92% 45%, 100% 0%);
}

.tag-content.wish .tag-footer {
  background: linear-gradient(180deg, #5c2028 0%, #722f37 60%, #8b2942 100%);
}

.tag-content.question .tag-footer {
  background: linear-gradient(180deg, #e0d6c0 0%, #ebe3d0 70%, #f8f4eb 100%);
}

/* 云脚到金珠的短绳 */
.tag-tassel-line {
  width: 2rpx;
  height: 14rpx;
  background: linear-gradient(180deg, #a89068 0%, #8b7355 100%);
  margin-top: -1rpx;
  border-radius: 1rpx;
}

/* 签文：竖排艺术字（行楷/隶书优先），长条签内可排更多字 */
.tag-text {
  font-size: 22rpx;
  writing-mode: vertical-rl;
  max-height: 148rpx;
  line-height: 1.55;
  letter-spacing: 6rpx;
  font-weight: 500;
  font-family: "STXingkai", "华文行楷", "Xingkai SC", "LiSu", "隶书", "SimLi", "KaiTi", "STKaiti", "楷体", "华文楷体", serif;
  position: relative;
  z-index: 1;
  margin-top: 8rpx;
  text-shadow: 0 1rpx 3rpx rgba(0,0,0,0.15), 0 0 1rpx rgba(0,0,0,0.08);
}

.tag-content.wish .tag-text {
  color: #f5eedf;
  text-shadow: 0 1rpx 3rpx rgba(0,0,0,0.35), 0 0 1rpx rgba(0,0,0,0.12);
}

.tag-content.question .tag-text {
  color: #3d2e1f;
  text-shadow: 0 1rpx 3rpx rgba(200, 180, 140, 0.25), 0 0 1rpx rgba(0,0,0,0.06);
}

/* 金珠 */
.tag-bead {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  margin-top: 2rpx;
  background: radial-gradient(circle at 32% 32%, #f0e6c8, #c9a227 45%, #8b6914 100%);
  box-shadow: 0 0 0 1rpx rgba(180, 150, 80, 0.5), inset 0 1rpx 0 rgba(255,255,255,0.35);
}

/* 双缕流苏容器 */
.tag-tassel {
  position: relative;
  width: 28rpx;
  height: 28rpx;
  margin-top: 4rpx;
  display: flex;
  justify-content: center;
  align-items: flex-start;
}

/* 单缕：细条从中心点向下外撇 */
.tassel-strand {
  position: absolute;
  top: 0;
  left: 50%;
  width: 4rpx;
  height: 22rpx;
  border-radius: 2rpx;
  transform-origin: top center;
  margin-left: -2rpx;
}

.tassel-l {
  transform: translateX(-50%) rotate(-24deg);
}

.tassel-r {
  transform: translateX(-50%) rotate(24deg);
}

.tag-content.wish .tassel-strand {
  background: linear-gradient(180deg, #a52a2a 0%, #8b0000 50%, #5d0000 100%);
  box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.2);
}

.tag-content.question .tassel-strand {
  background: linear-gradient(180deg, #d4af37 0%, #b8860b 60%, #8b6914 100%);
  box-shadow: 0 2rpx 6rpx rgba(180, 134, 11, 0.3);
}

/* 摇曳动画 */
@keyframes sway {
  0% { transform: rotate(-3deg); }
  100% { transform: rotate(3deg); }
}

/* 入场动画 */
.pop-in {
  animation: popIn 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
}

@keyframes popIn {
  from { opacity: 0; transform: scale(0); }
  to { opacity: 1; transform: scale(1); }
}

/* 底部操作 */
.footer-actions {
  padding: 30rpx 40rpx 60rpx;
  background: rgba(255,255,255,0.9);
  border-radius: 40rpx 40rpx 0 0;
  box-shadow: 0 -10rpx 30rpx rgba(0,0,0,0.05);
}

.category-scroll {
  display: flex;
  white-space: nowrap;
  margin-bottom: 30rpx;
}

.category-item {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 54rpx; /* 固定高度 */
  line-height: normal; /* 重置行高 */
  padding: 0 30rpx;
  margin-right: 20rpx;
  font-size: 26rpx;
  background: #f0f0f0;
  color: #666;
  border-radius: 30rpx;
  transition: all 0.3s;
  box-sizing: border-box; /* 确保 padding 包含在宽高内 */
  vertical-align: middle; /* 垂直对齐保证 */
}

.category-item.active {
  background: var(--sysu-red);
  color: white;
}

/* 发布按钮 */
.post-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #7C191E, #a52a2a);
  color: white;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 44rpx;
  border: none;
  box-shadow: 0 8rpx 20rpx rgba(124, 25, 30, 0.3);
}

.post-btn::after {
  border: none;
}

/* 弹窗样式 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 100;
}

.post-modal {
  position: fixed;
  left: 0;
  right: 0;
  bottom: -100%;
  background: #fff;
  border-radius: 40rpx 40rpx 0 0;
  z-index: 101;
  padding: 0 40rpx 40rpx; /* 顶部留白由背景图填充 */
  transition: bottom 0.3s ease;
  overflow: hidden;
}

.modal-top-bg {
  width: 120%;
  height: 180rpx;
  margin-left: -10%; /* 稍微溢出让装饰感更强 */
  margin-bottom: 20rpx;
  display: block;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  position: relative; /* 确保在背景图之上 */
}

.wish-input {
  width: 100%;
  height: 200rpx;
  background: #f8f8f8;
  padding: 20rpx;
  box-sizing: border-box;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.word-count {
  text-align: right;
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
}

.section-title {
  margin-top: 30rpx;
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.category-tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rpx;
}

.tag-item {
  padding: 10rpx 30rpx;
  background: #f0f0f0;
  border-radius: 30rpx;
  margin-right: 20rpx;
  margin-bottom: 20rpx;
  font-size: 24rpx;
  color: #666;
}

.tag-active {
  background: var(--sysu-red);
  color: #fff;
}

.anonymous-switch {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 30rpx;
  font-size: 28rpx;
  color: #333;
}

.modal-footer {
  margin-top: 50rpx;
  padding-bottom: env(safe-area-inset-bottom);
}

.submit-btn {
  background: var(--sysu-red) !important;
  color: #fff !important;
  border-radius: 50rpx;
  font-weight: bold;
}


