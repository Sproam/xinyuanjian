/* pages/detail/detail.wxss */

.container {
  padding: 12rpx 12rpx;
  background: linear-gradient(to bottom, #7C191E, #a52a2a, #f6f6f6);
  min-height: 100vh;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.question-card {
  width: 90%;
  margin: 0 auto 30rpx auto;
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx;
  box-shadow: 0 10rpx 40rpx rgba(0,0,0,0.06);
  box-sizing: border-box;
  animation: fadeIn 0.5s ease-out;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f9f9f9;
}

.user-info {
  display: flex;
  align-items: center;
}

.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  background: #eee;
  border: 2rpx solid #fff;
  box-shadow: 0 4rpx 8rpx rgba(0,0,0,0.1);
}

.nickname {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.tag {
  font-size: 20rpx;
  color: var(--sysu-red);
  background: rgba(124, 25, 30, 0.08);
  padding: 6rpx 16rpx;
  border-radius: 24rpx;
  font-weight: 500;
}

.content {
  margin-bottom: 30rpx;
}

.question-text {
  font-size: 34rpx;
  color: #2c2c2c;
  line-height: 1.7;
  letter-spacing: 0.5rpx;
  text-align: justify;
}

.card-footer {
  border-top: 1rpx solid #eee;
  padding-top: 20rpx;
}

.time {
  font-size: 24rpx;
  color: #999;
}

/* 回答区域 */
.answer-section {
  margin-top: 20rpx;
  width: 100%;
}

.answer-list {
  width: 90%;
  margin: 0 auto;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.03);
  overflow: hidden;
  box-sizing: border-box;
}

.section-title {
  width: 90%;
  margin: 0 auto 24rpx auto;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.title-left {
  display: flex;
  align-items: center;
}

.title-left text:first-child {
  font-size: 28rpx;
  font-weight: 600;
  color: #666;
  padding-left: 10rpx;
  border-left: 6rpx solid var(--sysu-red);
  line-height: 1;
  margin-right: 16rpx;
}

.sort-tabs {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #999;
}

.sort-tabs .tab {
  padding: 8rpx 10rpx;
  transition: color 0.3s;
}

.sort-tabs .tab.active {
  color: var(--sysu-red);
  font-weight: bold;
}

.sort-tabs .divider {
  margin: 0 4rpx;
  color: #eee;
}

.count {
  font-size: 24rpx;
  color: #999;
}

.answer-item {
  width: 100%;
  margin: 0;
  background: #fff;
  padding: 30rpx;
  border-bottom: 2rpx solid #f0f0f0;
  box-sizing: border-box;
  transition: background 0.2s;
  position: relative;
  box-shadow: none;
  border-radius: 0;
}

.answer-item:last-child {
  border-bottom: none;
  margin-bottom: 0;
}

.answer-item:active {
  background: #fdfdfd;
  transform: none;
}

.answer-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.volunteer-info {
  display: flex;
  align-items: center;
}

.v-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  background: #fdf5f5;
  border: 1rpx solid #eee;
}

.v-meta {
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.v-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 4rpx;
}

.v-major {
  font-size: 22rpx;
  color: #888;
}

.thank-badge {
  font-size: 20rpx;
  color: #ff9800;
  background: rgba(255, 152, 0, 0.15);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

.answer-content {
  font-size: 30rpx;
  color: #3a3a3a;
  line-height: 1.65;
  margin-bottom: 24rpx;
  letter-spacing: 0.5rpx;
}

.answer-actions {
  display: flex;
  border-top: 1rpx solid #f9f9f9;
  padding-top: 20rpx;
  justify-content: flex-end;
}

.action-item {
  display: flex;
  align-items: center;
  margin-left: 30rpx;
  margin-right: 0;
  font-size: 24rpx;
  color: #666;
  padding: 10rpx 20rpx;
  background: #f8f8f8;
  border-radius: 30rpx;
  transition: all 0.2s;
}

.action-item:active {
  background: #eee;
}

.empty-answers {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 26rpx;
}

.empty-img {
  width: 200rpx;
  height: 200rpx;
  opacity: 0.3;
  margin-bottom: 20rpx;
}

/* 底部回复栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20px);
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  box-shadow: 0 -4rpx 24rpx rgba(0,0,0,0.06);
  z-index: 100;
}

.reply-input {
  flex: 1;
  background: #f0f2f5;
  height: 80rpx;
  border-radius: 40rpx;
  padding: 0 34rpx;
  font-size: 28rpx;
  margin-right: 24rpx;
  border: 1rpx solid transparent;
  transition: all 0.3s;
}

.reply-input:focus {
  background: #fff;
  border-color: rgba(124, 25, 30, 0.2);
  box-shadow: 0 0 0 4rpx rgba(124, 25, 30, 0.05);
}

.send-btn {
  width: 140rpx !important;
  height: 80rpx;
  background: var(--sysu-red);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin: 0 !important;
  box-shadow: 0 4rpx 12rpx rgba(124, 25, 30, 0.3);
  transition: all 0.2s;
}

.send-btn:active {
  transform: scale(0.96);
  box-shadow: 0 2rpx 6rpx rgba(124, 25, 30, 0.2);
}

.send-btn[disabled] {
  opacity: 0.6;
  background: #ccc !important; 
  box-shadow: none;
  color: rgba(255,255,255,0.9) !important;
}

/* 感谢动效 */
.heart-container {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
  z-index: 9999;
}

.heart {
  position: absolute;
  bottom: 120rpx;
  font-size: 40rpx;
  animation-name: float-up;
  animation-timing-function: ease-out;
  animation-fill-mode: both;
  opacity: 0;
}

@keyframes float-up {
  0% {
    transform: translateY(0) scale(0.5) rotate(0);
    opacity: 0;
  }
  20% {
    opacity: 1;
    transform: translateY(-100rpx) scale(1.2) rotate(10deg);
  }
  100% {
    transform: translateY(-800rpx) scale(1) rotate(-20deg);
    opacity: 0;
  }
}

/* 返回按钮容器 */
.nav-back {
  position: fixed;
  left: 20rpx;
  width: 32px; 
  height: 32px;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.2); 
  border-radius: 50%;
  backdrop-filter: blur(4px);
  flex-shrink: 0;
}

.back-arrow {
  width: 10px;
  height: 10px;
  border-left: 2px solid #ffffff;
  border-bottom: 2px solid #ffffff;
  transform: rotate(45deg);
  margin-left: 4px; /* 视觉修正居中 */
  margin-top: -1px; /* 微调垂直居中 */
}
