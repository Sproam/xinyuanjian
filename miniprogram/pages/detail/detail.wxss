/* pages/detail/detail.wxss */
.container {
  padding: 30rpx;
  background: linear-gradient(to bottom, #7C191E, #a52a2a, #f6f6f6);
  min-height: 100vh;
  padding-bottom: 120rpx;
  box-sizing: border-box;
}

.question-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.05);
  margin-bottom: 40rpx;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.user-info {
  display: flex;
  align-items: center;
}

.avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  background: #eee;
}

.nickname {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.tag {
  font-size: 22rpx;
  color: var(--sysu-red);
  background: rgba(124, 25, 30, 0.1);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.content {
  margin-bottom: 30rpx;
}

.question-text {
  font-size: 32rpx;
  color: #333;
  line-height: 1.6;
}

.card-footer {
  border-top: 1rpx solid #eee;
  padding-top: 20rpx;
}

.time {
  font-size: 24rpx;
  color: #999;
}

/* 回答区域 */
.answer-section {
  margin-top: 20rpx;
}

.section-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.section-title text:first-child {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.count {
  font-size: 24rpx;
  color: #999;
}

.answer-item {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.02);
}

.answer-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.volunteer-info {
  display: flex;
  align-items: center;
}

.v-avatar {
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  margin-right: 12rpx;
  background: #fdf5f5;
}

.v-meta {
  display: flex;
  flex-direction: column;
}

.v-name {
  font-size: 26rpx;
  font-weight: bold;
  color: #333;
}

.v-major {
  font-size: 20rpx;
  color: #999;
}

.thank-badge {
  font-size: 20rpx;
  color: #ff9800;
  background: rgba(255, 152, 0, 0.1);
  padding: 2rpx 12rpx;
  border-radius: 10rpx;
}

.answer-content {
  font-size: 28rpx;
  color: #444;
  line-height: 1.6;
  margin-bottom: 20rpx;
}

.answer-actions {
  display: flex;
  border-top: 1rpx solid #f5f5f5;
  padding-top: 15rpx;
}

.action-item {
  display: flex;
  align-items: center;
  margin-right: 40rpx;
  font-size: 24rpx;
  color: #666;
}

.action-item icon {
  margin-right: 8rpx;
}

.empty-answers {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 26rpx;
}

.empty-img {
  width: 200rpx;
  height: 200rpx;
  opacity: 0.3;
  margin-bottom: 20rpx;
}

/* 底部回复栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 110rpx;
  background: #fff;
  display: flex;
  align-items: center;
  padding: 0 30rpx;
  box-shadow: 0 -2rpx 20rpx rgba(0,0,0,0.05);
  padding-bottom: env(safe-area-inset-bottom);
}

.reply-input {
  flex: 1;
  background: #f5f5f5;
  height: 70rpx;
  border-radius: 35rpx;
  padding: 0 30rpx;
  font-size: 28rpx;
  margin-right: 20rpx;
}

.send-btn {
  width: 140rpx !important;
  height: 70rpx;
  background: var(--sysu-red);
  color: #fff;
  font-size: 26rpx;
  border-radius: 35rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin: 0 !important;
}

.send-btn[disabled] {
  opacity: 0.6;
  background: var(--sysu-red) !important;
  color: rgba(255,255,255,0.8) !important;
}

/* 感谢动效 */
.heart-container {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
  z-index: 9999;
}

.heart {
  position: absolute;
  bottom: 120rpx;
  font-size: 40rpx;
  animation-name: float-up;
  animation-timing-function: ease-out;
  animation-fill-mode: both;
  opacity: 0;
}

@keyframes float-up {
  0% {
    transform: translateY(0) scale(0.5) rotate(0);
    opacity: 0;
  }
  20% {
    opacity: 1;
    transform: translateY(-100rpx) scale(1.2) rotate(10deg);
  }
  100% {
    transform: translateY(-800rpx) scale(1) rotate(-20deg);
    opacity: 0;
  }
}

