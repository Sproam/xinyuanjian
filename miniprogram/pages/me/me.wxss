/* pages/me/me.wxss */
.container {
  padding: 20rpx 0;
  background: linear-gradient(to bottom, #7C191E, #a52a2a, #f6f6f6);
  min-height: 100vh;
  padding-bottom: 200rpx; /* 为 TabBar 留出更多空间 */
  box-sizing: border-box;
}

.user-card {
  width: 90%;
  margin: 0 auto 30rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 24rpx;
  padding: 40rpx;
  box-shadow: 0 10rpx 40rpx rgba(0,0,0,0.08); /* 优化投影 */
  box-sizing: border-box;
  animation: slideUp 0.5s ease-out;
}

@keyframes slideUp {
  from { transform: translateY(20rpx); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}

.user-header {
  display: flex;
  align-items: center;
  margin-bottom: 40rpx;
}

.avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  margin-right: 32rpx;
  background: #eee;
  border: 4rpx solid #fff;
  box-shadow: 0 6rpx 16rpx rgba(0,0,0,0.1);
}

.user-info {
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.nickname {
  font-size: 38rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
  letter-spacing: 1rpx;
}

.role-tag {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  display: inline-block;
  width: fit-content;
}

.role-tag.student {
  color: #7C191E;
  background: rgba(124, 25, 30, 0.1);
}

.role-tag.volunteer {
  color: var(--sysu-red);
  background: rgba(124, 25, 30, 0.1);
}

.user-stats {
  display: flex;
  justify-content: space-around;
  align-items: center;
  border-top: 1rpx solid #f5f5f5;
  padding-top: 30rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
}

.stat-line {
  width: 1rpx;
  height: 40rpx;
  background: #eee;
}

/* 菜单列表 */
.menu-list {
  width: 90%;
  margin: 0 auto 40rpx;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.04);
  animation: slideUp 0.5s ease-out 0.1s backwards;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 34rpx 40rpx;
  border-bottom: 2rpx solid #f9f9f9;
  transition: background 0.2s;
}

.menu-item:active {
  background: #fcfcfc;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-left {
  display: flex;
  align-items: center;
}

.menu-icon {
  font-size: 36rpx;
  margin-right: 24rpx;
  width: 50rpx;
  text-align: center;
}

.menu-text {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
}

.arrow {
  font-size: 26rpx;
  color: #ccc;
  font-weight: bold;
}

/* 开发工具 - 身份切换 */
.dev-tools {
  width: 90%;
  margin: 60rpx auto 0;
  padding: 0;
}

.section-title {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 20rpx;
  display: block;
}

.switch-btns {
  display: flex;
  gap: 20rpx;
}

.switch-btn {
  flex: 1;
  height: 80rpx;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  color: #666;
  border: 1rpx solid #eee;
  border-radius: 12rpx;
  padding: 0;
  margin: 0 !important;
}

.switch-btn.active {
  background: var(--sysu-red);
  color: #fff;
  border-color: var(--sysu-red);
}

.footer {
  margin-top: 100rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-bottom: 60rpx;
}

.footer text {
  font-size: 22rpx;
  color: #ccc;
  margin-bottom: 8rpx;
}
